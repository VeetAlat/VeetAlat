[Desktop Entry]
Type=Application
Name=Roach Rider
Comment=The roach needs to ride its way through the neon grid
Icon=roachrider
Exec=roachrider
X-Nemo-Application-Type=silica-qt5

[X-Sailjail]
# Sandboxed. Audio is the only permission, for the game's sounds; it only
# writes its own data directory, ~/.local/share/org.veetalat/roachrider.
Permissions=Audio
OrganizationName=org.veetalat
ApplicationName=roachrider

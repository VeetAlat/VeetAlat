[Desktop Entry]
Type=Application
Name=Yleisuutiset
Comment=Unofficial reader for Yle's news feeds
Icon=harbour-yleisuutiset
Exec=harbour-yleisuutiset
X-Nemo-Application-Type=silica-qt5

[X-Sailjail]
# Needs the network to fetch Yle's RSS feeds; writes only its own cache
# in ~/.local/share/org.veetalat/yleisuutiset.
Permissions=Internet
OrganizationName=org.veetalat
ApplicationName=yleisuutiset

[Desktop Entry]
Type=Application
Name=AmbienceCrop
Comment=Frame a photo for an ambience, with a blur around it
Icon=ambiencecrop
Exec=ambiencecrop
X-Nemo-Application-Type=silica-qt5

[X-Sailjail]
# Pictures and Downloads: reading the photo and saving the result in
# Pictures/AmbienceCrop. MediaIndexing: the gallery picker lists photos.
# Ambience: asking the ambience service to make the ambience.
Permissions=Pictures;Downloads;MediaIndexing;Ambience
OrganizationName=org.veetalat
ApplicationName=ambiencecrop
